<resources>

    <!-- Seu estilo customizado -->
    <style name="TokenBoxStyle">
        <item name="android:layout_width">39dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/token_cell</item>
        <item name="android:textColor">@color/BordasDouradas</item>
        <item name="android:textSize">18sp</item>
        <item name="android:maxLength">1</item>
        <item name="android:inputType">text</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="RegraSenhaItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">4dp</item>
        <item name="android:fontFamily">@font/cinzel_font_bold</item>
    </style>

    <!-- Exemplo de estilo -->
    <style name="Atributo">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="AtributoEdit">
        <item name="android:layout_width">70dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:inputType">number</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:background">@drawable/retangulo_borda_fundo_transparente</item>
    </style>

    <style name="CampoFixo" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/BordasDouradas</item>
        <item name="hintTextColor">@color/BordasDouradas</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="android:textColor">@color/BordasDouradas</item>
        <item name="android:fontFamily">@font/cinzel_font_bold</item>
    </style>

    <style name="Reinos.ChoiceChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="checkedIconVisible">false</item>
        <item name="chipBackgroundColor">@color/chip_bg_color</item>
        <item name="chipStrokeColor">@color/BordasDouradas</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/BordasDouradas</item>
        <item name="rippleColor">@color/chip_ripple</item>
    </style>

    <style name="CardItemStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">180dp</item>
        <item name="android:layout_margin">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">@drawable/card_ripple</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">8dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/DouradoEspecial</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
    </style>

    <style name="CardFrameStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="CardBgStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:adjustViewBounds">true</item>
    </style>

    <style name="CardInnerBorderStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:src">@drawable/card_inner_border</item>
    </style>

    <style name="CardTitleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">6</item>
    </style>


    <style name="AppDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="DiceToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>


        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>

        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/DouradoEspecial</item>
        <item name="strokeColor">@color/DouradoEspecial</item>
        <item name="strokeWidth">1dp</item>
    </style>


    <!-- Base genérico para tipografia da app -->
    <style name="Text" />

    <!-- Subestilo que usamos nos rótulos do HUD -->
    <style name="Text.NavLabel" parent="Text">
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/cinzel_font_bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">@color/DouradoEspecial</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Shape.LargeX" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Shape.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Chip.Meta" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/DarkSiena</item>
        <item name="chipStrokeColor">@color/BordasDouradas</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/DouradoEspecial</item>
        <item name="rippleColor">@color/DouradoEspecial</item>
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">28dp</item>

    </style>

    <style name="Widget.IconButton.Ghost" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">8dp</item>
    </style>


        <!-- Style genérico chamado "Shape" para satisfazer @style/Shape -->
        <style name="Shape" parent="ShapeAppearance.Material3.LargeComponent">
            <item name="cornerFamily">rounded</item>
            <item name="cornerSize">24dp</item>
        </style>


    <style name="Shape.Rounded18">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>



    <style name="TextLabelKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textColor">@color/DouradoEspecial</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="TextLabelValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textColor">@color/BordasDouradas</item>
        <item name="android:padding">4dp</item>
    </style>


    <style name="AttrItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">6dp</item>
    </style>

    <style name="AttrLabel">
        <item name="android:textColor">@color/DouradoEspecial</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="AttrValue">
        <item name="android:textColor">@color/BordasDouradas</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="IdRow">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="IdKey">
        <item name="android:textColor">@color/DouradoEspecial</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="IdVal">
        <item name="android:textColor">@color/BordasDouradas</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>



</resources>
