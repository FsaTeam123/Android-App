<resources>

    <!-- Seu estilo customizado -->
    <style name="TokenBoxStyle">
        <item name="android:layout_width">39dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/token_cell</item>
        <item name="android:textColor">@color/BordasDouradas</item>
        <item name="android:textSize">18sp</item>
        <item name="android:maxLength">1</item>
        <item name="android:inputType">text</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="RegraSenhaItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">4dp</item>
        <item name="android:fontFamily">@font/cinzel_font_bold</item>
    </style>

    <!-- Exemplo de estilo -->
    <style name="Atributo">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="AtributoEdit">
        <item name="android:layout_width">70dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:inputType">number</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:background">@drawable/retangulo_borda_fundo_transparente</item>
    </style>

    <style name="CampoFixo" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/BordasDouradas</item>
        <item name="hintTextColor">@color/BordasDouradas</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="android:textColor">@color/BordasDouradas</item>
        <item name="android:fontFamily">@font/cinzel_font_bold</item>
    </style>

    <style name="Reinos.ChoiceChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="checkedIconVisible">false</item>
        <item name="chipBackgroundColor">@color/chip_bg_color</item>
        <item name="chipStrokeColor">@color/BordasDouradas</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/BordasDouradas</item>
        <item name="rippleColor">@color/chip_ripple</item>
    </style>



</resources>
