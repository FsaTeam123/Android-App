<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/verifyCodeFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tela_password_v2">

    <!-- Fechar (direita) -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/fechar"
        android:src="@drawable/close_circle_svgrepo_com"
        android:backgroundTint="@color/BordasDouradas"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- DIVISOR PADRÃO (com margens laterais 22dp para equivaler ao padding das outras telas) -->

    <!-- Título (55dp abaixo do divisor, igual ao Forgot) -->
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/topDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="22dp"
        android:alpha="0.6"
        app:dividerColor="@color/BordasDouradas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnClose" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:fontFamily="@font/cinzel_font_bold"
        android:text="@string/reinos_perdidos"
        android:textAlignment="center"
        android:textColor="@color/BordasDouradas"
        android:textFontWeight="600"
        android:textSize="50sp"
        app:layout_constraintTop_toBottomOf="@id/topDivider" />

    <!-- Painel do token -->
    <LinearLayout
        android:id="@+id/cardTokenPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/retangulo_borda_fundo_transparente"
        android:orientation="vertical"
        android:padding="18dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel_font_bold"
            android:includeFontPadding="false"
            android:paddingBottom="20dp"
            android:text="@string/insira_o_token_enviado_para_o_seu_email"
            android:textAlignment="center"
            android:textColor="@color/BordasDouradas"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/token_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="8"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <com.example.androidapprpg.utils.OtpEditText
                android:id="@+id/digit1"
                style="@style/TokenBoxStyle"
                android:layout_width="0dp"
                app:cursorColor="@color/DouradoEspecial"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp" />

            <com.example.androidapprpg.utils.OtpEditText
                android:id="@+id/digit2"
                style="@style/TokenBoxStyle"
                android:layout_width="0dp"
                app:cursorColor="@color/DouradoEspecial"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp" />

            <com.example.androidapprpg.utils.OtpEditText
                android:id="@+id/digit3"
                style="@style/TokenBoxStyle"
                app:cursorColor="@color/DouradoEspecial"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp" />

            <com.example.androidapprpg.utils.OtpEditText
                android:id="@+id/digit4"
                style="@style/TokenBoxStyle"
                android:layout_width="0dp"
                app:cursorColor="@color/DouradoEspecial"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp" />

            <com.example.androidapprpg.utils.OtpEditText
                android:id="@+id/digit5"
                style="@style/TokenBoxStyle"
                app:cursorColor="@color/DouradoEspecial"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp" />

            <com.example.androidapprpg.utils.OtpEditText
                android:id="@+id/digit6"
                style="@style/TokenBoxStyle"
                app:cursorColor="@color/DouradoEspecial"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp" />

            <com.example.androidapprpg.utils.OtpEditText
                android:id="@+id/digit7"
                style="@style/TokenBoxStyle"
                app:cursorColor="@color/DouradoEspecial"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp" />

            <com.example.androidapprpg.utils.OtpEditText
                android:id="@+id/digit8"
                style="@style/TokenBoxStyle"
                app:cursorColor="@color/DouradoEspecial"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botão Confirmar -->
    <Button
        android:id="@+id/confirmarToken"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:layout_marginTop="48dp"
        android:backgroundTint="@color/DarkSiena"
        android:fontFamily="@font/cinzel_font_bold"
        android:text="@string/verificar"
        android:textColor="@color/BordasDouradas"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/cardTokenPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
