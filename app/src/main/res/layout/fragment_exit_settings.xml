<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/master"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_preto_claro"
    tools:context=".ui.fragment.GameManager.ExitSettingsFragment">

    <!-- TopBar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:background="@color/VermelhoEscuro"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/ExitSettingsFragmentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel_font_bold"
            android:text="@string/opções"
            android:textColor="@color/DouradoEspecial"
            android:textSize="23sp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <View
        android:id="@+id/separadorDourado"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@color/DouradoEspecial"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <LinearLayout
        android:id="@+id/settingsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/retangulo_borda_fundo_transparente"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/separadorDourado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.5"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">


        <!-- Música -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/retangulo_arredondado"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/music_svgrepo_com"
                app:tint="@color/DouradoEspecial"
                android:contentDescription="@string/exit_session"/>



            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/cinzel_font_bold"
                android:text="@string/Musica"
                android:textColor="@color/BordasDouradas"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switchAudio"
                android:layout_width="80dp"
                android:layout_height="50dp"
                android:thumbTint="@color/BordasDouradas"
                android:trackTint="@color/OleYeller" />
        </LinearLayout>

        <!-- Espaço -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp"/>

        <!-- Sons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/retangulo_arredondado"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/sound_svgrepo_com"
                app:tint="@color/DouradoEspecial"
                android:contentDescription="@string/exit_session"/>



            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/cinzel_font_bold"
                android:text="@string/Som"
                android:textColor="@color/BordasDouradas"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switchSons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/BordasDouradas"
                android:trackTint="@color/OleYeller" />
        </LinearLayout>

        <!-- Ação: Encerrar sessão (linha clicável que abre o pop-up) -->
        <LinearLayout
            android:id="@+id/rowSignOut"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/retangulo_arredondado"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/logout_svgrepo_com"
                app:tint="@color/DouradoEspecial"
                android:contentDescription="@string/exit_session"/>

            <TextView
                android:id="@+id/closeSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cinzel_font_bold"
                android:text="@string/exit_session"
                android:textColor="@color/BordasDouradas"
                android:textSize="15sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
