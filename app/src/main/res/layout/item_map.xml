<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardUseCompatPadding="false"
    app:cardElevation="4dp"
    app:contentPadding="0dp"
    app:strokeColor="@color/DouradoEspecial"
    app:strokeWidth="1dp">

<androidx.constraintlayout.widget.ConstraintLayout
android:layout_width="match_parent"
android:layout_height="wrap_content">

<!-- Thumbnail 16:9 -->
<com.google.android.material.imageview.ShapeableImageView
    android:id="@+id/imgThumb"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:contentDescription="@string/mapa"
    android:scaleType="centerCrop"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintDimensionRatio="16:9"
    tools:src="@drawable/sample_map"/>

<!-- Scrim inferior para o título (reduzido) -->
<View
    android:id="@+id/titleScrim"
    android:layout_width="0dp"
    android:layout_height="40dp"
    android:background="@drawable/item_map_title"
    app:layout_constraintStart_toStartOf="@id/imgThumb"
    app:layout_constraintEnd_toEndOf="@id/imgThumb"
    app:layout_constraintBottom_toBottomOf="@id/imgThumb" />

<!-- Nome do mapa -->
<TextView
    android:id="@+id/txtName"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginBottom="10dp"
    android:maxLines="1"
    android:ellipsize="end"
    android:textStyle="bold"
    android:textSize="18sp"
    android:textColor="@android:color/white"
    app:layout_constraintStart_toStartOf="@id/titleScrim"
    app:layout_constraintEnd_toEndOf="@id/titleScrim"
    app:layout_constraintBottom_toBottomOf="@id/titleScrim"
    tools:text="Floresta de Ébano"/>

<!-- Checkbox (selecionar) -->
<com.google.android.material.checkbox.MaterialCheckBox
    android:id="@+id/cbSelect"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:useMaterialThemeColors="false"
    android:buttonTint="@color/vermelho_metalico"
    app:layout_constraintTop_toTopOf="@id/imgThumb"
    app:layout_constraintStart_toStartOf="@id/imgThumb" />

<!-- Ações no topo direito -->
<LinearLayout
    android:id="@+id/actionsRow"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="6dp"
    app:layout_constraintTop_toTopOf="@id/imgThumb"
    app:layout_constraintEnd_toEndOf="@id/imgThumb">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnPreview"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp"
        android:tint="@color/vermelho_metalico"
        android:src="@android:drawable/ic_menu_view" />

    <Space android:layout_width="4dp" android:layout_height="0dp"/>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnEdit"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp"
        android:tint="@color/vermelho_metalico"
        android:contentDescription="@string/editar"
        app:srcCompat="@drawable/edit_1_svgrepo_com" />

    <Space android:layout_width="4dp" android:layout_height="0dp"/>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnDelete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp"
        android:tint="@color/vermelho_metalico"
        android:contentDescription="@string/excluir"
        app:srcCompat="@drawable/delete_filled_svgrepo_com" />
</LinearLayout>


    <!-- Scrim de seleção (leva um escurecido suave) -->
    <View
        android:id="@+id/selectedScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Check grandão central -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/selectedCheck"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:visibility="gone"
        android:alpha="0"
        app:tint="@color/DouradoEspecial"
        app:srcCompat="@drawable/check_circle_svgrepo_com"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
