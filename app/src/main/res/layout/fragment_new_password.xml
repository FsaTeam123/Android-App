<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollNewPassword"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tela_password_v2"
    android:fillViewport="true"
    android:scrollbars="vertical"
    tools:context=".ui.activity.ActivityNewPassword">

    <!-- FILHO DIRETO do ScrollView: altura WRAP_CONTENT -->
    <LinearLayout
        android:id="@+id/rootContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar -->
        <RelativeLayout
            android:id="@+id/topBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/fechar"
                android:src="@drawable/close_circle_svgrepo_com"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:backgroundTint="@color/BordasDouradas" />
        </RelativeLayout>

        <!-- Conteúdo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="0dp"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/topDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.6"
                app:dividerColor="@color/BordasDouradas" />

            <!-- Painel -->
            <LinearLayout
                android:id="@+id/passwordPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:background="@drawable/retangulo_borda_fundo_transparente"
                android:clipToOutline="true"
                android:clipToPadding="false"
                android:maxWidth="420dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:text="@string/nova_senha_de_acesso"
                    android:textAlignment="center"
                    android:textColor="@color/BordasDouradas"
                    android:textSize="20sp" />

                <!-- Regras -->
                <LinearLayout
                    android:id="@+id/regraSenhaLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/SuaSenha"
                        style="@style/RegraSenhaItem"
                        android:text="@string/sua_senha"
                        android:textColor="@color/BordasDouradas"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/regraMinCaracteres"
                        style="@style/RegraSenhaItem"
                        android:layout_marginStart="30dp"
                        android:text="@string/pelo_menos_8_caracteres"
                        android:textColor="@color/BordasDouradas" />

                    <TextView
                        android:id="@+id/regraMaiuscula"
                        style="@style/RegraSenhaItem"
                        android:layout_marginStart="30dp"
                        android:text="@string/pelo_menos_1_letra_mai_scula"
                        android:textColor="@color/BordasDouradas" />

                    <TextView
                        android:id="@+id/regraNumero"
                        style="@style/RegraSenhaItem"
                        android:layout_marginStart="30dp"
                        android:text="@string/pelo_menos_1_n_mero"
                        android:textColor="@color/BordasDouradas" />

                    <TextView
                        android:id="@+id/regraEspecial"
                        style="@style/RegraSenhaItem"
                        android:layout_marginStart="30dp"
                        android:text="@string/pelo_menos_1_caractere_especial"
                        android:textColor="@color/BordasDouradas" />
                </LinearLayout>

                <!-- Nova senha -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/novaSenhaLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/nova_senha"
                    android:textColorHint="@color/BordasDouradas"
                    app:boxBackgroundColor="@color/Crowshead"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:boxStrokeWidth="2dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/novaSenha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/baseline_lock_24"
                        android:drawablePadding="8dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:padding="12dp"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirmar senha -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/confirmarSenhaLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/confirmar_senha"
                    android:textColorHint="@color/BordasDouradas"
                    app:boxBackgroundColor="@color/Crowshead"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:boxStrokeWidth="2dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/confirmarSenha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/baseline_lock_24"
                        android:drawablePadding="8dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:padding="12dp"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botão -->
                <Button
                    android:id="@+id/btnTrocarSenha"
                    android:layout_width="250dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="@color/DarkSiena"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:text="@string/alterar_senha"
                    android:textColor="@color/BordasDouradas"
                    android:textSize="18sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
