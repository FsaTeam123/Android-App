<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- CONTAINER COM BORDA -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerFicha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/retangulo_borda_fundo_transparente"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- mochila -->
            <FrameLayout
                android:id="@+id/mochilaContainer"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/mochilaImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/mochila"
                    android:contentDescription="Mochila"
                    android:scaleType="centerCrop"
                     />

            </FrameLayout>

            <!-- BLOCO DOS CAMPOS -->
            <LinearLayout
                android:id="@+id/extraFieldsLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/mochilaContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

               <!-- MOCHILA -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Mochila"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/DuraçãoMagia"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Quantidade -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Quantidade"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/quantidadeMochila"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Peso -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Peso"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/pesoMochila"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Peso Máximo -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Peso Máximo"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/pesoMáximoMochila"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Peso Limite -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Peso Limite"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/pesoLimiteMochila"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Peso Atual -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Peso Atual"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/pesoAtualMochila"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Preço -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Preço"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/preçoMochila"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- DESCRIÇÃO -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Descrição"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/DescriçãoMochila"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>


            <!-- BOTÃO -->
            <Button
                android:id="@+id/editButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Editar"
                android:backgroundTint="@color/DouradoEspecial"
                android:textColor="@color/VermelhoEscuro"
                android:fontFamily="@font/cinzel_font_bold"
                app:layout_constraintTop_toBottomOf="@id/extraFieldsLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
