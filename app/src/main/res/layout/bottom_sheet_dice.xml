<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dicePanelRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:padding="16dp"
    android:paddingBottom="24dp"
    android:background="@drawable/retangulo_arredondado">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Topo: título + switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DADOS"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/DouradoEspecial"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swGmRoll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rolo de GM"
                android:textColor="@color/cinza_claro"/>
        </LinearLayout>

        <!-- Vantagem / Normal / Desvantagem -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tgAdvantage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:singleSelection="true"
            app:checkedButton="@id/btnNorm">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDis"
                style="@style/DiceToggleButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Desv."
                android:checkable="true"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNorm"
                style="@style/DiceToggleButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Normal"
                android:checked="true"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdv"
                style="@style/DiceToggleButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Vant."
                android:checkable="true"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Cabeçalho colunas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="Dado"
                android:textColor="@color/cinza_claro"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2.8"
                android:text="Quantidade"
                android:textColor="@color/cinza_claro"/>
        </LinearLayout>

        <!-- ======= D4 ======= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    app:srcCompat="@drawable/dice_twenty_faces"
                    app:tint="@color/DouradoEspecial"
                    android:contentDescription="D4"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="D4"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgD4"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="2.8"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:checkable="true"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- ======= D6 ======= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    app:srcCompat="@drawable/dice_6"
                    app:tint="@color/DouradoEspecial"
                    android:contentDescription="D6"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="D6"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgD6"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="2.8"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:checkable="true"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- ======= D8 ======= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    app:srcCompat="@drawable/dice_eight_faces_eight_svgrepo_com__1_"
                    app:tint="@color/DouradoEspecial"
                    android:contentDescription="D8"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="D8"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgD8"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="2.8"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:checkable="true"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- ======= D10 ======= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    app:srcCompat="@drawable/dice_twenty_faces"
                    app:tint="@color/DouradoEspecial"
                    android:contentDescription="D10"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="D10"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgD10"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="2.8"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:checkable="true"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- ======= D12 ======= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    app:srcCompat="@drawable/dice_twenty_faces"
                    app:tint="@color/DouradoEspecial"
                    android:contentDescription="D12"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="D12"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgD12"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="2.8"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:checkable="true"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- ======= D20 ======= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    app:srcCompat="@drawable/dice_twenty_faces"
                    app:tint="@color/DouradoEspecial"
                    android:contentDescription="D20"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="D20"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgD20"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="2.8"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:checkable="true"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- ======= D100 ======= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    app:srcCompat="@drawable/dice_twenty_faces"
                    app:tint="@color/DouradoEspecial"
                    android:contentDescription="D100"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="D100"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgD100"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="2.8"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:checkable="true"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- ======= FUDGE ======= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    app:srcCompat="@drawable/dice_twenty_faces"
                    app:tint="@color/DouradoEspecial"
                    android:contentDescription="Fudge"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Fudge"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgFudge"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="2.8"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:checkable="true"/>
                <com.google.android.material.button.MaterialButton style="@style/DiceToggleButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:checkable="true"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Rodapé: modificador + ações -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etModifier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned"
                android:textColor="@color/white"
                android:hint="Modificador (ex.: +2)"/>
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:paddingTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limpar"
                android:textColor="@color/white"
                android:backgroundTint="@color/vermelho_metalico"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRollNow"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Rolar"
                android:textColor="@color/white"
                android:backgroundTint="@color/vermelho_metalico"/>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
