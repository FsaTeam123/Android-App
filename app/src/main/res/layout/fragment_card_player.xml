<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerFicha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/retangulo_borda_fundo_transparente"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Avatar -->
            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/avatarImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    android:contentDescription="Avatar do personagem"
                    android:scaleType="centerCrop"
                    android:src="@drawable/baseline_person_24" />

                <ImageButton
                    android:id="@+id/avatarEditButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:backgroundTint="@color/DouradoEspecial"
                    android:contentDescription="Editar avatar"
                    android:padding="4dp"
                    android:src="@drawable/ic_edit"
                    />
            </FrameLayout>

            <!-- Nome -->
            <TextView
                android:id="@+id/characterName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/cinzel_font_bold"
                android:gravity="center"
                android:text="Thrain Cantonegro"
                android:textAlignment="center"
                android:textColor="@color/DouradoEspecial"
                android:textSize="24sp"
                app:layout_constraintTop_toBottomOf="@id/avatarContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Info -->
            <TextView
                android:id="@+id/characterInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Anão • Necromante • Nível 3"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/characterName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Atributos -->
            <LinearLayout
                android:id="@+id/attributesLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/characterInfo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- 3 linhas de atributos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Atributo"
                            android:layout_width="99dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:fontFamily="@font/cinzel_font_bold"
                            android:text="Força"
                            android:textColor="@color/DouradoEspecial" />

                        <EditText
                            android:id="@+id/forcaEdit"
                            style="@style/AtributoEdit"
                            android:text="14"
                            android:translationX="-20dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="end|center_vertical">

                        <TextView
                            style="@style/Atributo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:fontFamily="@font/cinzel_font_bold"
                            android:text="Constituição"
                            android:textColor="@color/DouradoEspecial" />

                        <EditText
                            android:id="@+id/constituicaoEdit"
                            style="@style/AtributoEdit"
                            android:text="15" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="1dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Atributo"
                            android:layout_width="99dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:fontFamily="@font/cinzel_font_bold"
                            android:text="Destreza"
                            android:textColor="@color/DouradoEspecial" />

                        <EditText
                            android:id="@+id/destrezaEdit"
                            style="@style/AtributoEdit"
                            android:text="12"
                            android:translationX="-20dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="end|center_vertical">

                        <TextView
                            style="@style/Atributo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:fontFamily="@font/cinzel_font_bold"
                            android:text="Inteligência"
                            android:textColor="@color/DouradoEspecial" />

                        <EditText
                            android:id="@+id/inteligenciaEdit"
                            style="@style/AtributoEdit"
                            android:text="13" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Atributo"
                            android:layout_width="99dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:fontFamily="@font/cinzel_font_bold"
                            android:text="Carisma"
                            android:textColor="@color/DouradoEspecial" />

                        <EditText
                            android:id="@+id/carismaEdit"
                            style="@style/AtributoEdit"
                            android:text="16"
                            android:translationX="-20dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="end|center_vertical">

                        <TextView
                            style="@style/Atributo"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:textColor="@color/DouradoEspecial"
                            android:fontFamily="@font/cinzel_font_bold"
                            android:text="Sabedoria" />

                        <EditText
                            android:id="@+id/sabedoriaEdit"
                            style="@style/AtributoEdit"
                            android:text="10" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>


            <!-- Campos Extras -->
            <LinearLayout
                android:id="@+id/extraFieldsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/attributesLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!--Riqueza-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Atributo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/DouradoEspecial"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:text="Riqueza" />

                    <Spinner
                        android:id="@+id/riquezaSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/DouradoEspecial"
                        android:popupBackground="@color/white"
                        android:spinnerMode="dropdown" />
                </LinearLayout>

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/BordasDouradas" />

                <!--Pericias-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Atributo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/DouradoEspecial"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:text="Perícias" />

                    <Spinner
                        android:id="@+id/periciasSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/DouradoEspecial"
                        android:popupBackground="@color/white"
                        android:spinnerMode="dropdown"
                         />
                </LinearLayout>

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/BordasDouradas" />


                <!-- Raça -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Atributo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/DouradoEspecial"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:text="Raça" />

                    <Spinner
                        android:id="@+id/racaSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/DouradoEspecial"
                        android:popupBackground="@color/white"
                        android:spinnerMode="dropdown"
                         />
                </LinearLayout>

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/BordasDouradas" />


                <!-- Origem -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Atributo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/DouradoEspecial"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:text="Origem" />

                    <Spinner
                        android:id="@+id/origemSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/DouradoEspecial"
                        android:popupBackground="@color/white"
                        android:spinnerMode="dropdown"
                         />
                </LinearLayout>

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/BordasDouradas" />


                <!-- Divindade -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Atributo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/DouradoEspecial"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:text="Divindade" />

                    <Spinner
                        android:id="@+id/divindadeSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/DouradoEspecial"
                        android:popupBackground="@color/white"
                        android:spinnerMode="dropdown"
                         />
                </LinearLayout>

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/BordasDouradas" />


                <!-- Classe -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Atributo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/DouradoEspecial"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:text="Classe" />

                    <Spinner
                        android:id="@+id/classeSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/DouradoEspecial"
                        android:popupBackground="@color/white"
                        android:spinnerMode="dropdown"
                         />
                </LinearLayout>
            </LinearLayout>

            <!-- Botão Editar -->
            <Button
                android:id="@+id/editButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/DouradoEspecial"
                android:fontFamily="@font/cinzel_font_bold"
                android:text="Editar"
                android:textColor="@color/VermelhoEscuro"
                app:layout_constraintTop_toBottomOf="@id/extraFieldsLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
