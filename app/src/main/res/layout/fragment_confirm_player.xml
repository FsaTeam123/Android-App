<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/confirm_player"
    android:background="@color/fundo_preto_claro"
    android:fitsSystemWindows="false">

    <!-- Vignette de fundo (suave) -->
    <ImageView
        android:id="@+id/bgVignette"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_vignette"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- TopBar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:background="@color/VermelhoEscuro"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Space
            android:id="@+id/leftSpacer"
            android:layout_width="40dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/magiaTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel_font_bold"
            android:text="@string/iniciar_sessão"
            android:textColor="@color/DouradoEspecial"
            android:textSize="23sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:textAlignment="center"
            app:layout_constraintStart_toEndOf="@id/leftSpacer"
            app:layout_constraintEnd_toStartOf="@id/btnClose"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/fechar"
            android:padding="8dp"
            android:src="@drawable/close_button_svgrepo_com"
            app:tint="@color/DouradoEspecial"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Separador dourado -->
    <View
        android:id="@+id/separadorDourado"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@color/DouradoEspecial"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Painel central (card RPG) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/painel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp"
        app:cardUseCompatPadding="true"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#161616"
        app:strokeColor="@color/DouradoEspecial"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/separadorDourado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Conteúdo do painel com gradiente e ornamentos -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rpg_panel_bg"
            android:padding="20dp">

            <!-- Ornamento: linhas + diamante -->
            <View
                android:id="@+id/ornLeft"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:background="@color/DouradoEspecial"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ornDiamond"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintHorizontal_weight="1"/>

            <ImageView
                android:id="@+id/ornDiamond"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_diamond_gold"
                android:contentDescription="@null"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/lottie"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"/>

            <View
                android:id="@+id/ornRight"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:background="@color/DouradoEspecial"
                app:layout_constraintStart_toEndOf="@id/ornDiamond"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintHorizontal_weight="1"/>

            <!-- Animação -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie"
                android:layout_width="168dp"
                android:layout_height="176dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/confirm_arrow"
                app:layout_constraintTop_toBottomOf="@id/ornDiamond"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Título dentro do painel -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Confirmação"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/cinzel_font_bold"
                android:textColor="@color/DouradoEspecial"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/lottie"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Mensagem -->
            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Tudo pronto! Confirme para continuar."
                android:textSize="15sp"
                android:lineSpacingExtra="2dp"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="@color/DouradoEspecial"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Botão Confirmar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/confirmar"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:fontFamily="@font/cinzel_font_bold"
                android:textColor="@color/fundo_preto_claro"
                app:backgroundTint="@color/DouradoEspecial"
                app:rippleColor="#33FFFFFF"
                app:icon="@drawable/ic_check_bold"
                app:iconPadding="8dp"
                app:iconGravity="textStart"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                app:cornerRadius="14dp"
                app:layout_constraintTop_toBottomOf="@id/tvMessage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/voltar"
                android:textAllCaps="false"
                android:fontFamily="@font/cinzel_font_bold"
                android:textColor="@color/DouradoEspecial"
                app:icon="@drawable/left_arrow_svgrepo_com"
                app:iconTint="@color/DouradoEspecial"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:strokeColor="@color/DouradoEspecial"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintTop_toBottomOf="@id/btnConfirm"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
