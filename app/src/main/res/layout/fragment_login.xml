<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/login_background"
    tools:context=".ui.fragment.Login_Register.LoginFragment">

    <!-- TÍTULO (fora do card) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/titleCodex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/codex"
            android:textSize="60sp"
            android:fontFamily="@font/cinzel_font_bold"
            android:textColor="@color/DouradoEspecial"
            android:gravity="center"/>

        <TextView
            android:id="@+id/titleRpg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rpg_login"
            android:textSize="45sp"
            android:fontFamily="@font/cinzel_font_bold"
            android:textColor="@color/DouradoEspecial"
            android:gravity="center"/>
    </LinearLayout>

    <!-- CARD COM BORDA TRANSPARENTE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/retangulo_borda_fundo_transparente"
        android:orientation="vertical"
        android:layout_margin="15dp"
        android:gravity="center_horizontal">

        <!-- Conteúdo do card (padding real fica aqui) -->
        <LinearLayout
            android:id="@+id/cardInner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                android:id="@+id/welcomeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bem_vindo"
                android:textAlignment="center"
                android:textSize="15sp"
                android:fontFamily="@font/cinzel_font_bold"
                android:textColor="@color/BordasDouradas"
                android:layout_marginBottom="8dp"/>

            <!-- Email -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/Email"
                android:textColorHint="@color/BordasDouradas"
                app:hintTextColor="@color/BordasDouradas"
                app:boxBackgroundMode="outline"
                app:cursorColor="@color/DouradoEspecial"
                app:boxBackgroundColor="@color/Crowshead"
                app:boxStrokeColor="@color/BordasDouradas"
                app:boxStrokeWidth="2dp"
                app:boxCornerRadiusTopStart="25dp"
                app:boxCornerRadiusTopEnd="25dp"
                app:boxCornerRadiusBottomStart="25dp"
                app:boxCornerRadiusBottomEnd="25dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/baseline_email_24"
                    android:drawablePadding="8dp"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:inputType="textEmailAddress"
                    android:minHeight="50dp"
                    android:padding="12dp"
                    android:textColor="@color/BordasDouradas"
                    android:textColorHint="@color/BordasDouradas"
                    android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Senha -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/password_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/Senha"
                android:textColorHint="@color/BordasDouradas"
                app:hintTextColor="@color/BordasDouradas"
                app:boxBackgroundMode="outline"
                app:cursorColor="@color/DouradoEspecial"
                app:boxBackgroundColor="@color/Crowshead"
                app:boxStrokeColor="@color/BordasDouradas"
                app:boxStrokeWidth="2dp"
                app:boxCornerRadiusTopStart="25dp"
                app:boxCornerRadiusTopEnd="25dp"
                app:boxCornerRadiusBottomStart="25dp"
                app:boxCornerRadiusBottomEnd="25dp"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/BordasDouradas">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:drawableStart="@drawable/baseline_lock_24"
                    android:drawablePadding="8dp"
                    android:inputType="textPassword"
                    android:textColorHint="@color/BordasDouradas"
                    android:textColor="@color/BordasDouradas"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:textSize="15sp"
                    android:padding="12dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/forgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Fortgot_Password"
                android:textSize="12sp"
                android:fontFamily="@font/cinzel_font_bold"
                android:textColor="@color/BordasDouradas"
                android:layout_gravity="end"
                android:paddingTop="8dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- AÇÕES (login / registrar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <FrameLayout
            android:id="@+id/loginButton"
            android:layout_width="270dp"
            android:layout_height="60dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/btn2"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <TextView
                android:id="@+id/txtloginbutton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/Login"
                android:paddingStart="50dp"
                android:paddingEnd="50dp"
                android:textColor="@color/BordasDouradas"
                android:textSize="26sp"
                android:fontFamily="@font/breeserif_regular"
                android:includeFontPadding="false"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/sentence"
            android:textSize="14sp"
            android:fontFamily="@font/cinzel_font_bold"
            android:textColor="@color/BordasDouradas"
            android:layout_gravity="center_horizontal"
            android:paddingTop="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register"
            android:textSize="18sp"
            android:fontFamily="@font/cinzel_font_bold"
            android:textColor="@color/BordasDouradas"
            android:layout_gravity="center_horizontal"
            android:paddingTop="8dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</LinearLayout>
