<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mochilaRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_preto_claro">

    <!-- TopBar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:background="@color/VermelhoEscuro"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Spacer para balancear o Close -->
        <Space
            android:id="@+id/leftSpacer"
            android:layout_width="40dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Título central -->
        <TextView
            android:id="@+id/mochilaTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel_font_bold"
            android:text="@string/mochila"
            android:textColor="@color/DouradoEspecial"
            android:textSize="23sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:textAlignment="center"
            app:layout_constraintStart_toEndOf="@id/leftSpacer"
            app:layout_constraintEnd_toStartOf="@id/btnClose"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Botão Close -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/fechar"
            android:padding="8dp"
            android:src="@drawable/close_button_svgrepo_com"
            app:tint="@color/DouradoEspecial"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Separador dourado -->
    <View
        android:id="@+id/separadorDourado"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@color/DouradoEspecial"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- CARD principal -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCentro"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        app:cardUseCompatPadding="true"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/DouradoEspecial"
        app:strokeWidth="2dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/separadorDourado"
        app:layout_constraintBottom_toTopOf="@+id/navHud"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <ImageView
                android:id="@+id/iconCarta"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cartas"
                android:src="@drawable/backpack_svgrepo_com"
                app:tint="@color/DouradoEspecial"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tituloCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cinzel_font_bold"
                android:text="@string/selecione_mochila"
                android:textSize="20sp"
                android:textColor="@color/VermelhoEscuro"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toEndOf="@id/iconCarta"
                app:layout_constraintTop_toTopOf="@id/iconCarta"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/subtituloCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/subtitulo_nova_carta"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="6dp"
                app:layout_constraintStart_toStartOf="@id/tituloCard"
                app:layout_constraintTop_toBottomOf="@id/tituloCard"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- BOTÃO COMEÇAR (centralizado no card) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnComecar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="@string/comecar"
                android:textAllCaps="true"
                android:fontFamily="@font/cinzel_font_bold"
                android:textSize="16sp"
                android:letterSpacing="0.03"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="16dp"
                app:icon="@drawable/play_svgrepo_com"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/DouradoEspecial"
                app:backgroundTint="@color/VermelhoEscuro"
                app:strokeColor="@color/DouradoEspecial"
                app:strokeWidth="2dp"
                app:rippleColor="@color/DouradoEspecial"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/subtituloCard"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.5"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- HUD de navegação -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navHud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/DouradoEspecial"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/SurfaceGlass"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/cardCentro"
        app:layout_constraintEnd_toEndOf="@id/cardCentro">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="92dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- ESQUERDA: botão + label -->
            <LinearLayout
                android:id="@+id/navAnterior"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageButton
                    android:id="@+id/btnAnterior"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_nav_icon_selector"
                    android:foreground="@drawable/ripple_gold"
                    android:contentDescription="@string/anterior"
                    android:tooltipText="@string/anterior"
                    android:padding="10dp"
                    android:src="@drawable/left_arrow_svgrepo_com"/>

                <TextView
                    android:id="@+id/labelAnterior"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/anterior"
                    android:textAllCaps="true"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.03"
                    android:textColor="@color/BordasDouradas"/>
            </LinearLayout>

            <!-- CENTRO: indicador -->
            <LinearLayout
                android:id="@+id/navCentro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintStart_toEndOf="@id/navAnterior"
                app:layout_constraintEnd_toStartOf="@id/navProximo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0.5">

                <TextView
                    android:id="@+id/labelPagina"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carta 1/12"
                    android:textAllCaps="true"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.03"
                    android:textColor="@color/DouradoEspecial"/>
            </LinearLayout>

            <!-- DIREITA: botão + label -->
            <LinearLayout
                android:id="@+id/navProximo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageButton
                    android:id="@+id/btnProximo"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_nav_icon_selector"
                    android:foreground="@drawable/ripple_gold"
                    android:contentDescription="@string/proximo"
                    android:tooltipText="@string/proximo"
                    android:padding="10dp"
                    android:src="@drawable/right_arrow_next_svgrepo_com"/>

                <TextView
                    android:id="@+id/labelProximo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/proximo"
                    android:textAllCaps="true"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.03"
                    android:textColor="@color/BordasDouradas"/>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
