<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- CONTAINER COM BORDA -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerFicha"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:background="@drawable/card_nine"
            android:padding="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- BLOCO DOS CAMPOS -->
            <LinearLayout
                android:id="@+id/extraFieldsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- NOME MOCHILA -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mochila"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"/>


                <!-- NOME MOCHILA -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mochila"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"/>

                <!-- NOME MOCHILA -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mochila"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nomeMochila"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas"
                        android:padding="12dp"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- QUANTIDADE -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Quantidade"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/quantidadeMochila"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas"
                        android:padding="12dp"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>






                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Peso Máximo"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Peso Máximo"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"/>



                <!-- PESO LIMITE -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Peso Limite"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"/>

                <!-- PESO ATUAL -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Peso Atual"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"/>

                <!-- PREÇO -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Preço"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"/>

                <!-- DESCRIÇÃO -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Descrição"
                    android:background="@drawable/retangulo_borda_fundo_transparente"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"/>

            </LinearLayout>

            <!-- BOTÃO -->
            <Button
                android:id="@+id/editButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/DouradoEspecial"
                android:fontFamily="@font/cinzel_font_bold"
                android:text="Editar"
                android:textColor="@color/VermelhoEscuro"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.502"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/extraFieldsLayout" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
