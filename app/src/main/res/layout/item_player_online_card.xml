<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="@color/DarkSiena">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/retangulo_arredondado"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <!-- Ícone -->
        <ImageView
            android:id="@+id/playerIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/icone_jogador"
            android:src="@drawable/baseline_person_24"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Nome do Jogador -->
        <TextView
            android:id="@+id/playerNameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel_font_bold"
            android:text="@string/nome_do_jogador"
            android:textColor="@color/BordasDouradas"
            android:textSize="16sp"
            app:layout_constraintTop_toTopOf="@id/playerIcon"
            app:layout_constraintStart_toEndOf="@id/playerIcon"
            app:layout_constraintEnd_toStartOf="@id/inviteButton"
            app:layout_constraintBottom_toBottomOf="@id/playerIcon"
            app:layout_constraintVertical_bias="0.5" />

        <!-- Botão Convidar -->
        <Button
            android:id="@+id/inviteButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="100dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:fontFamily="@font/cinzel_font_bold"
            android:text="CONVIDAR"
            android:textSize="13sp"
            android:textColor="@color/VermelhoEscuro"
            android:backgroundTint="@color/DouradoEspecial"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.5" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
