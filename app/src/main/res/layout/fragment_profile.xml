<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/new_home_fragment_image"
    tools:context=".ui.fragment.Home.ProfileFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TOP BAR (translúcida) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:background="@color/opaco_40"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Space
                android:id="@+id/startSpacer"
                android:layout_width="56dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/btnFechar"
                android:layout_width="56dp"
                android:layout_height="42dp"
                android:contentDescription="@string/fechar"
                android:src="@drawable/close_circle_svgrepo_com"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/settingsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cinzel_font_bold"
                android:text="@string/Profile"
                android:textColor="@color/DouradoEspecial"
                android:textSize="30sp"
                android:textAlignment="center"
                app:layout_constraintStart_toEndOf="@id/startSpacer"
                app:layout_constraintEnd_toStartOf="@id/btnFechar"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Linha dourada -->
        <View
            android:id="@+id/separadorDourado"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:background="@color/DouradoEspecial"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- CONTEÚDO -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/separadorDourado"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Card translúcido -->
            <LinearLayout
                android:id="@+id/cardHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/retangulo_arrendondado_60_opacidade"
                android:padding="20dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Avatar + botão câmera ligeiramente "para fora" -->
                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="108dp"
                        android:layout_height="108dp"
                        android:contentDescription="@string/content_desc_avatar"
                        android:src="@drawable/icone_reinosperdidos"
                        app:civ_border_color="@color/BordasDouradas"
                        app:civ_border_width="2dp"
                        tools:src="@drawable/icone_reinosperdidos" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnChangePhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:contentDescription="@string/alterar_foto"
                        app:fabCustomSize="28dp"
                        app:maxImageSize="18dp"
                        app:backgroundTint="@color/DouradoEspecial"
                        app:tint="@color/Crowshead"
                        app:srcCompat="@android:drawable/ic_menu_camera"
                        android:stateListAnimator="@null"
                        app:elevation="0dp"
                        app:pressedTranslationZ="0dp"
                        app:useCompatPadding="false"
                        android:translationX="8dp"
                        android:translationY="8dp" />

                </FrameLayout>

                <!-- Nome -->
                <TextView
                    android:id="@+id/txtNameTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:textColor="@color/DouradoEspecial"
                    android:letterSpacing="0.01"
                    tools:text="Nome Do Usuario" />

                <!-- Nickname -->
                <TextView
                    android:id="@+id/txtNicknameSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="15sp"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:textColor="@color/BordasDouradas"
                    android:alpha="0.95"
                    tools:text="nickname" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="10dp"
                    android:alpha="0.18"
                    android:background="@color/BordasDouradas" />

                <!-- Nome -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/nome"
                    android:textColorHint="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/Crowshead"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:boxStrokeWidth="2dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtNome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/baseline_person_24"
                        android:drawablePadding="8dp"
                        android:minHeight="50dp"
                        android:padding="12dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:textColor="@color/BordasDouradas"
                        android:textSize="16sp"
                        android:imeOptions="actionNext"
                        tools:text="Usuario Teste" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/Email"
                    android:textColorHint="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/Crowshead"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:boxStrokeWidth="2dp"
                    android:layout_marginTop="10dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/baseline_email_24"
                        android:drawablePadding="8dp"
                        android:minHeight="50dp"
                        android:padding="12dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:textColor="@color/BordasDouradas"
                        android:textSize="16sp"
                        android:maxLines="1"
                        android:inputType="textEmailAddress|textNoSuggestions"
                        android:imeOptions="actionNext"
                        android:ellipsize="end"
                        tools:text="usuario@exemplo.com" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Nickname -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/nickname"
                    android:textColorHint="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/Crowshead"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:boxStrokeWidth="2dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtNickname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/baseline_sword"
                        android:drawablePadding="8dp"
                        android:minHeight="50dp"
                        android:padding="12dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:textColor="@color/BordasDouradas"
                        android:textSize="16sp"
                        android:imeOptions="actionNext"
                        tools:text="user123" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Gênero -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilGenero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/Genêro"
                    android:textColorHint="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/Crowshead"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:boxStrokeWidth="2dp"
                    app:endIconMode="dropdown_menu"
                    app:endIconTint="@color/BordasDouradas"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/edtGenero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/genders"
                        android:drawablePadding="8dp"
                        android:minHeight="50dp"
                        android:padding="12dp"
                        android:inputType="none"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:textColor="@color/BordasDouradas"
                        android:textSize="16sp"
                        tools:text="Masculino" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Senha -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/Senha"
                    android:textColorHint="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/Crowshead"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:boxStrokeWidth="2dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/BordasDouradas"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtSenha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        android:padding="12dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:text="********"
                        android:textColor="@color/BordasDouradas"
                        android:textSize="16sp"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        tools:text="********" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botões -->
                <LinearLayout
                    android:id="@+id/rowEditSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="16dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnEditar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="44dp"
                        android:textSize="18sp"
                        android:background="@drawable/btn1"
                        android:textColor="@color/DouradoEspecial"
                        android:textAllCaps="false"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="12dp"
                        android:text="@string/editar" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSalvar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:minHeight="40dp"
                        android:textSize="18sp"
                        android:background="@drawable/btn1"
                        android:textColor="@color/DouradoEspecial"
                        android:textAllCaps="false"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="12dp"
                        android:text="@string/salvar" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
