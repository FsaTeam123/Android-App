<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dicePlayFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_preto_claro">

    <!-- App bar fixa (topo) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:background="@color/VermelhoEscuro"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Título centralizado -->
        <TextView
            android:id="@+id/AndroidAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel_font_bold"
            android:text="@string/rpg"
            android:textColor="@color/DouradoEspecial"
            android:textSize="23sp"
            android:gravity="center"
            android:textAlignment="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Botão fechar (ícone) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@android:color/transparent"
            android:contentDescription="@string/fechar"
            app:icon="@drawable/close_button_svgrepo_com"
            app:iconSize="24dp"
            app:iconTint="@color/DouradoEspecial"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- divisor -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/BordasDouradas"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bandeja / Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTray"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="20dp"
        app:cardUseCompatPadding="true"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <!-- Conteúdo do card com scrim DENTRO -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.example.androidapprpg.dicecore.DicePhysicsView
                android:id="@+id/dicePhysicsView"
                android:background="@drawable/retangulo_borda_fundo_transparente"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <!-- Scrim/gradiente na base (recortado pelos cantos do card) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_gravity="bottom"
                android:background="@drawable/scrim_bottom_gradient"/>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Barra superior SOBRE o card -->
    <LinearLayout
        android:id="@+id/overlayTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:gravity="center_vertical|center_horizontal"
        app:layout_constraintTop_toTopOf="@id/cardTray"
        app:layout_constraintStart_toStartOf="@id/cardTray"
        app:layout_constraintEnd_toEndOf="@id/cardTray">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenDicePanel"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escolher dados"
            app:icon="@drawable/dice_twenty_faces"
            android:backgroundTint="@color/VermelhoEscuro"
            android:textColor="@color/white"
            app:iconTint="@color/DouradoEspecial"
            app:iconPadding="8dp"
            app:iconGravity="start"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMode"
            style="@style/Widget.Material3.Chip.Assist.Elevated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Modo: Normal"
            app:chipIcon="@drawable/bolt_svgrepo_com"
            app:chipIconTint="@color/DouradoEspecial"/>
    </LinearLayout>

    <!-- Barra inferior FORA do card -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total: —"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReroll"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rolar de novo"
            android:backgroundTint="@color/VermelhoEscuro"
            android:textColor="@color/white"
            app:icon="@drawable/replay_svgrepo_com"
            app:iconTint="@color/DouradoEspecial"
            app:iconPadding="8dp"
            app:iconGravity="start"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Histórico"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/VermelhoEscuro"
            android:textColor="@color/white"
            app:iconTint="@color/DouradoEspecial"
            app:icon="@drawable/history_svgrepo_com"
            app:iconPadding="6dp"
            app:iconGravity="start"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
