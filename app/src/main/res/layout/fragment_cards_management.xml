<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/CardFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragment.GameManager.CardFragment"
    android:background="@color/fundo_preto_claro">

    <!-- TopBar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:background="@color/VermelhoEscuro"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel_font_bold"
            android:text="@string/cartas"
            android:textColor="@color/DouradoEspecial"
            android:textSize="23sp"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Separador dourado abaixo da TopBar -->
    <View
        android:id="@+id/separadorDourado"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@color/DouradoEspecial"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Conteúdo rolável -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/rootScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/separadorDourado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- GRID -->
            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/cardsGridLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:columnCount="2"
                app:rowCount="3">

                <!-- 1: Biografia -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card1"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_margin="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/card_ripple"
                    app:layout_columnWeight="1"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="8dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/DouradoEspecial"
                    app:cardBackgroundColor="@android:color/transparent"
                    >

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/bg1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="@null"
                            />

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/card_inner_border"
                            android:contentDescription="@null"/>

                        <TextView
                            android:id="@+id/title1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/biografia"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="@color/BordasDouradas"
                            android:shadowColor="#99000000"
                            android:shadowDx="0"
                            android:shadowDy="2"
                            android:shadowRadius="6"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2: Armas -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card2"
                    style="@style/CardItemStyle"
                    app:layout_columnWeight="1"
                    >
                    <FrameLayout style="@style/CardFrameStyle">
                        <ImageView
                            android:id="@+id/bg2"
                            style="@style/CardBgStyle"
                            />
                        <ImageView style="@style/CardInnerBorderStyle"/>
                        <TextView
                            android:id="@+id/title2"
                            style="@style/CardTitleStyle"
                            android:text="@string/arma"
                            android:textColor="@color/BordasDouradas"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3: Poderes -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card3"
                    style="@style/CardItemStyle"
                    app:layout_columnWeight="1"
                    >
                    <FrameLayout style="@style/CardFrameStyle">
                        <ImageView
                            android:id="@+id/bg3"
                            style="@style/CardBgStyle"
                            />
                        <ImageView style="@style/CardInnerBorderStyle"/>
                        <TextView
                            android:id="@+id/title3"
                            style="@style/CardTitleStyle"
                            android:text="@string/poder"
                            android:textColor="@color/BordasDouradas"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4: Magias -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card4"
                    style="@style/CardItemStyle"
                    app:layout_columnWeight="1"
                    >
                    <FrameLayout style="@style/CardFrameStyle">
                        <ImageView
                            android:id="@+id/bg4"
                            style="@style/CardBgStyle"
                            />
                        <ImageView style="@style/CardInnerBorderStyle"/>
                        <TextView
                            android:id="@+id/title4"
                            style="@style/CardTitleStyle"
                            android:text="@string/magia"
                            android:textColor="@color/BordasDouradas"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5: Habilidades -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card5"
                    style="@style/CardItemStyle"
                    app:layout_columnWeight="1"
                    >
                    <FrameLayout style="@style/CardFrameStyle">
                        <ImageView
                            android:id="@+id/bg5"
                            style="@style/CardBgStyle"
                            />
                        <ImageView style="@style/CardInnerBorderStyle"/>
                        <TextView
                            android:id="@+id/title5"
                            style="@style/CardTitleStyle"
                            android:text="@string/habilidade"
                            android:textColor="@color/BordasDouradas"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 6: Mochila -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card6"
                    style="@style/CardItemStyle"
                    app:layout_columnWeight="1"
                    >
                    <FrameLayout style="@style/CardFrameStyle">
                        <ImageView
                            android:id="@+id/bg6"
                            style="@style/CardBgStyle"
                            />
                        <ImageView style="@style/CardInnerBorderStyle"/>
                        <TextView
                            android:id="@+id/title6"
                            style="@style/CardTitleStyle"
                            android:text="@string/mochila"
                            android:textColor="@color/BordasDouradas"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.gridlayout.widget.GridLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- OVERLAY FULLSCREEN -->
    <FrameLayout
        android:id="@+id/expandedOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E6000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/expandedCard"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="false"
                app:cardPreventCornerOverlap="true"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Arte da carta -->
                    <ImageView
                        android:id="@+id/expandedBg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="false"
                        />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/expandedContent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false">

                        <!-- Linha onde o título ficará centralizado -->
                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/titleGuide"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layout_constraintGuide_percent="0.095"/>

                        <!-- Botão fechar -->
                        <ImageView
                            android:id="@+id/btnCloseExpanded"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:contentDescription="@string/fechar"
                            android:src="@drawable/close_button_svgrepo_com"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:padding="4dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginEnd="6dp"
                            android:translationY="-15dp"
                            android:translationX="18dp"/>

                        <!-- Título centralizado -->
                        <TextView
                            android:id="@+id/expandedTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingStart="48dp"
                            android:paddingEnd="48dp"
                            android:text="TÍTULO"
                            android:textColor="@color/DouradoEspecial"
                            android:textSize="31sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/cinzel_font_bold"
                            android:shadowColor="#99000000"
                            android:shadowDx="0"
                            android:shadowDy="2"
                            android:shadowRadius="6"
                            app:layout_constrainedWidth="true"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/titleGuide"
                            app:layout_constraintBottom_toBottomOf="@id/titleGuide"/>

                        <!-- Corpo -->
                        <TextView
                            android:id="@+id/expandedBody"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/descricao"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            app:layout_constraintTop_toBottomOf="@id/expandedTitle"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
