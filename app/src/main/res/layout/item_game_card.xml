<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:layout_marginVertical="10dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    app:cardUseCompatPadding="false"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/BordasDouradas"
    app:cardBackgroundColor="@color/VermelhoEscuro"
    app:shapeAppearanceOverlay="@style/Shape.LargeX">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- HEADER GRADIENT BACKGROUND -->
        <FrameLayout
            android:id="@+id/headerBg"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_card_header_gradient"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ÍCONE DO JOGO -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/gameIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/baseline_sword"
            app:shapeAppearanceOverlay="@style/Shape.Circle"
            app:strokeColor="@color/DouradoEspecial"
            app:strokeWidth="1dp"
            app:tint="@color/DouradoEspecial"
            app:layout_constraintTop_toTopOf="@id/headerBg"
            app:layout_constraintBottom_toBottomOf="@id/headerBg"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- NOME DO JOGO -->
        <TextView
            android:id="@+id/gameNameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ordem do Dragão"
            android:textColor="@color/DouradoEspecial"
            android:textSize="18sp"
            android:fontFamily="@font/cinzel_font_bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toEndOf="@id/gameIcon"
            app:layout_constraintEnd_toStartOf="@id/gameIdChip"
            app:layout_constraintTop_toTopOf="@id/headerBg"
            app:layout_constraintBottom_toBottomOf="@id/headerBg"/>

        <!-- CHIP COM O ID DO JOGO (#159 etc) -->
        <TextView
            android:id="@+id/gameIdChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_chip_dourado"
            android:drawableStart="@drawable/hash_02_svgrepo_com"
            android:text="159"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="@color/VermelhoEscuro"
            android:fontFamily="@font/cinzel_font_bold"
            app:layout_constraintEnd_toStartOf="@id/actionsRow"
            app:layout_constraintTop_toTopOf="@id/headerBg"
            app:layout_constraintBottom_toBottomOf="@id/headerBg"/>

        <!-- BOTÕES (EDIT / DELETE) -->
        <LinearLayout
            android:id="@+id/actionsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/headerBg"
            app:layout_constraintBottom_toBottomOf="@id/headerBg">

            <ImageButton
                android:id="@+id/btnEditGame"
                android:layout_width="36dp"
                android:layout_height="36dp"
                style="@style/Widget.IconButton.Ghost"
                android:contentDescription="@string/editar"
                android:src="@drawable/edit_1_svgrepo_com"
                app:tint="@color/DouradoEspecial"/>

            <ImageButton
                android:id="@+id/btnDeleteGame"
                android:layout_width="36dp"
                android:layout_height="36dp"
                style="@style/Widget.IconButton.Ghost"
                android:contentDescription="@string/apagar"
                android:src="@drawable/delete_filled_svgrepo_com"
                app:tint="@color/DouradoEspecial"/>
        </LinearLayout>

        <!-- COLUNA DETALHES (sem a linha ID agora) -->
        <LinearLayout
            android:id="@+id/detailsCol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/headerBg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/enterButton">

            <!-- Mestre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/fire_svgrepo_com"
                    app:tint="@color/DouradoEspecial"
                    android:contentDescription="@string/mestre" />

                <TextView
                    android:id="@+id/mestreLabelTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mestre"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:textColor="@color/DouradoEspecial"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/mestreValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Thrain"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/cinzel_regular"
                    android:layout_weight="1"/>
            </LinearLayout>

            <!-- Nível -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/swords"
                    app:tint="@color/DouradoEspecial"
                    android:contentDescription="@string/nivel" />

                <TextView
                    android:id="@+id/nivelLabelTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nivel"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:textColor="@color/DouradoEspecial"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/nivelValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/cinzel_regular"/>
            </LinearLayout>

            <!-- Jogadores -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/users_svgrepo_com__1_"
                    app:tint="@color/DouradoEspecial"
                    android:contentDescription="@string/numero_de_jogadores" />

                <TextView
                    android:id="@+id/jogadoresLabelTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/numero_de_jogadores"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:textColor="@color/DouradoEspecial"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/jogadoresValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3/5"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/cinzel_regular"/>
            </LinearLayout>
        </LinearLayout>

        <!-- CTA “Entrar” -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/enterButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="137dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/cinzel_font_bold"
            android:text="entrar"
            android:textAllCaps="false"
            android:textColor="@color/VermelhoEscuro"
            app:backgroundTint="@color/DouradoEspecial"
            app:cornerRadius="16dp"
            app:icon="@drawable/login_bracket_svgrepo_com"
            app:iconPadding="8dp"
            app:iconTint="@color/VermelhoEscuro"
            app:layout_constraintTop_toTopOf="@id/detailsCol"
            app:layout_constraintBottom_toBottomOf="@id/detailsCol"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
