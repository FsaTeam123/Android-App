<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/forgotEmailFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|center_horizontal"
    android:background="@drawable/tela_password_v2"
    tools:context=".ui.fragment.ForgotPassword.ForgotPasswordFragment">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/fechar"
            android:src="@drawable/close_circle_svgrepo_com"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:backgroundTint="@color/BordasDouradas" />
    </LinearLayout>

    <!-- Conteúdo -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <!-- DIVISOR PADRÃO -->
            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/topDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.6"
                app:dividerColor="@color/BordasDouradas" />

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="55dp"
                android:fontFamily="@font/cinzel_font_bold"
                android:text="@string/reinos_perdidos"
                android:textAlignment="center"
                android:textColor="@color/BordasDouradas"
                android:textFontWeight="600"
                android:textSize="50dp" />

            <!-- Campo Email -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:padding="22dp">

            <EditText
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/custom_edittext"
                    android:backgroundTint="@color/Crowshead"
                    app:cursorColor="@color/DouradoEspecial"
                    android:drawableLeft="@drawable/baseline_email_24"
                    android:drawablePadding="8dp"
                    android:hint="@string/Email"
                    android:textSize="15dp"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:textColorHint="@color/BordasDouradas"
                    android:padding="12dp"
                    android:textColor="@color/BordasDouradas" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/insira_seu_endere_o_de_email_para_receber_instru_es_para_redefinir_sua_senha"
                    android:textSize="13sp"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:textColor="@color/BordasDouradas"
                    android:layout_gravity="end"
                    android:layout_marginTop="15dp"
                    android:paddingTop="8dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Botões -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <Button
                    android:id="@+id/enviar"
                    android:layout_width="250dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTint="@color/DarkSiena"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:text="@string/Enviar"
                    android:textAlignment="center"
                    android:textColor="@color/BordasDouradas"
                    android:textSize="18dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/lembrou_sua_senha"
                    android:textSize="14sp"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:textColor="@color/BordasDouradas"
                    android:layout_gravity="center_horizontal"
                    android:paddingTop="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/backToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Login"
                    android:textSize="18sp"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:textColor="@color/BordasDouradas"
                    android:layout_gravity="center_horizontal"
                    android:paddingTop="8dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
