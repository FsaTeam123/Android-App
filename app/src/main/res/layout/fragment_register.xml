<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:descendantFocusability="afterDescendants"
    android:background="@drawable/login_background"
    tools:context=".ui.fragment.Login_Register.RegisterFragment">

    <LinearLayout
        android:id="@+id/cadastro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar -->
        <RelativeLayout
            android:id="@+id/topBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/fechar"
                android:src="@drawable/close_circle_svgrepo_com"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:backgroundTint="@color/BordasDouradas" />
        </RelativeLayout>

        <!-- Conteúdo com padding lateral padrão 22dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <!-- Divider igual ao da NewPassword -->
            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/topDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:alpha="0.6"
                app:dividerColor="@color/BordasDouradas" />

            <!-- Card / Painel -->
            <LinearLayout
                android:id="@+id/painelCadastro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:maxWidth="420dp"
                android:background="@drawable/retangulo_borda_fundo_transparente"
                android:orientation="vertical"
                android:padding="20dp"
                android:clipToOutline="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:text="@string/cadastro"
                    android:textAlignment="center"
                    android:textColor="@color/BordasDouradas"
                    android:textSize="20sp"
                    android:layout_marginBottom="8dp"/>

                <!-- Nome -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/Nome_Completo"
                    android:textColorHint="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/Crowshead"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:boxStrokeWidth="2dp"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        android:drawableStart="@drawable/baseline_person_24"
                        android:drawablePadding="8dp"
                        android:padding="12dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas"
                        android:textSize="15sp"
                        android:imeOptions="actionNext"
                        android:autofillHints="name"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/Email"
                    android:textColorHint="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/Crowshead"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:boxStrokeWidth="2dp"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        android:drawableStart="@drawable/baseline_email_24"
                        android:drawablePadding="8dp"
                        android:padding="12dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas"
                        android:textSize="15sp"
                        android:inputType="textEmailAddress"
                        android:imeOptions="actionNext"
                        android:autofillHints="emailAddress"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Nickname -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/nickname"
                    android:textColorHint="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/Crowshead"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:boxStrokeWidth="2dp"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nickname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        android:drawableStart="@drawable/baseline_sword"
                        android:drawablePadding="8dp"
                        android:padding="12dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas"
                        android:textSize="15sp"
                        android:imeOptions="actionNext"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Sexo -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/Genêro"
                    android:textColorHint="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/Crowshead"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:boxStrokeWidth="2dp"
                    app:endIconMode="dropdown_menu"
                    app:endIconTint="@color/BordasDouradas"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/idSexo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/genders"
                        android:drawablePadding="8dp"
                        android:padding="12dp"
                        android:inputType="none"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas"/>
                </com.google.android.material.textfield.TextInputLayout>



                <!-- Senha -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/password_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/Senha"
                    android:textColorHint="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/Crowshead"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:boxStrokeWidth="2dp"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/BordasDouradas">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        android:drawableStart="@drawable/baseline_lock_24"
                        android:drawablePadding="8dp"
                        android:padding="12dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas"
                        android:textSize="15sp"
                        android:inputType="textPassword"
                        android:imeOptions="actionNext"
                        android:autofillHints="newPassword"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirmar Senha -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/check_password_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/Confirmar_Senha"
                    android:textColorHint="@color/BordasDouradas"
                    app:hintTextColor="@color/BordasDouradas"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/Crowshead"
                    app:boxStrokeColor="@color/BordasDouradas"
                    app:boxStrokeWidth="2dp"
                    app:boxCornerRadiusTopStart="25dp"
                    app:boxCornerRadiusTopEnd="25dp"
                    app:boxCornerRadiusBottomStart="25dp"
                    app:boxCornerRadiusBottomEnd="25dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/BordasDouradas">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/check_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        android:drawableStart="@drawable/baseline_lock_24"
                        android:drawablePadding="8dp"
                        android:padding="12dp"
                        android:fontFamily="@font/cinzel_font_bold"
                        android:textColor="@color/BordasDouradas"
                        android:textColorHint="@color/BordasDouradas"
                        android:textSize="15sp"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        android:autofillHints="newPassword"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Regras (bullets) -->
                <LinearLayout
                    android:id="@+id/regraSenhaLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/SuaSenha"
                        style="@style/RegraSenhaItem"
                        android:text="@string/sua_senha"
                        android:textColor="@color/BordasDouradas"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/regraMinCaracteres"
                        style="@style/RegraSenhaItem"
                        android:layout_marginStart="30dp"
                        android:text="@string/pelo_menos_8_caracteres"
                        android:textColor="@color/BordasDouradas" />

                    <TextView
                        android:id="@+id/regraMaiuscula"
                        style="@style/RegraSenhaItem"
                        android:layout_marginStart="30dp"
                        android:text="@string/pelo_menos_1_letra_mai_scula"
                        android:textColor="@color/BordasDouradas" />

                    <TextView
                        android:id="@+id/regraNumero"
                        style="@style/RegraSenhaItem"
                        android:layout_marginStart="30dp"
                        android:text="@string/pelo_menos_1_n_mero"
                        android:textColor="@color/BordasDouradas" />

                    <TextView
                        android:id="@+id/regraEspecial"
                        style="@style/RegraSenhaItem"
                        android:layout_marginStart="30dp"
                        android:text="@string/pelo_menos_1_caractere_especial"
                        android:textColor="@color/BordasDouradas" />
                </LinearLayout>

                <!-- Botão dentro do card -->
                <Button
                    android:id="@+id/registerButton"
                    android:layout_width="250dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:text="@string/Cadastrar"
                    android:textSize="18sp"
                    android:fontFamily="@font/cinzel_font_bold"
                    android:textColor="@color/BordasDouradas"
                    android:backgroundTint="@color/DarkSiena"/>
            </LinearLayout>

            <!-- Link Login -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:paddingTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Já é um aventureiro?"
                    android:textColor="@color/BordasDouradas"
                    android:textSize="14sp"
                    android:fontFamily="@font/cinzel_font_bold"/>

                <TextView
                    android:id="@+id/backToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="Faça Login"
                    android:textColor="@color/BordasDouradas"
                    android:textSize="18sp"
                    android:fontFamily="@font/cinzel_font_bold"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
