<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_quadriculado_branco"
    tools:context=".ui.fragment.GameManager.MapFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TOP BAR (translúcida ou sólida) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:background="@color/VermelhoEscuro"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Ícone do lado esquerdo -->
            <ImageView
                android:id="@+id/btnLeft"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/dice"
                android:src="@drawable/d20"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Ícone do lado direito -->
            <ImageView
                android:id="@+id/btnFechar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/fechar"
                android:src="@drawable/chat_icon"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Título centralizado entre os dois ícones -->
            <TextView
                android:id="@+id/settingsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cinzel_font_bold"
                android:text="@string/reinos_perdidos"
                android:textColor="@color/DouradoEspecial"
                android:textSize="23sp"
                android:textAlignment="center"
                app:layout_constraintStart_toEndOf="@id/btnLeft"
                app:layout_constraintEnd_toStartOf="@id/btnFechar"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
