<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/master"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/new_home_fragment_image"
    tools:context=".ui.fragment.Home.JoinGameFragment">

    <!-- Barra superior -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/VermelhoEscuro"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="76dp"
            android:fontFamily="@font/cinzel_font_bold"
            android:text="@string/Configurações"
            android:textColor="@color/DouradoEspecial"
            android:textSize="23sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.728" />

        <ImageView
            android:id="@+id/btnFechar"
            android:layout_width="56dp"
            android:layout_height="42dp"
            android:layout_marginStart="32dp"
            android:contentDescription="@string/fechar"
            android:src="@drawable/close_circle_svgrepo_com"
            app:layout_constraintBottom_toBottomOf="@id/settingsTitle"
            app:layout_constraintStart_toEndOf="@id/settingsTitle"
            app:layout_constraintTop_toTopOf="@id/settingsTitle"
            app:layout_constraintVertical_bias="1.0" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Separador -->
    <View
        android:id="@+id/separadorDourado"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@color/DouradoEspecial"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Card centralizado -->
    <LinearLayout
        android:id="@+id/settingsContainer"
        android:layout_width="359dp"
        android:layout_height="272dp"
        android:layout_marginTop="108dp"
        android:background="@drawable/retangulo_borda_fundo_transparente"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/separadorDourado"
        app:layout_constraintWidth_percent="0.9">

        <!-- Configuração de áudio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/retangulo_arredondado"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/cinzel_font_bold"
                android:text="@string/Musica"
                android:textColor="@color/BordasDouradas"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switchAudio"
                android:layout_width="80dp"
                android:layout_height="50dp"
                android:thumbTint="@color/BordasDouradas"
                android:trackTint="@color/OleYeller" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/retangulo_arredondado"

            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/termos_e_privacidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cinzel_font_bold"
                android:gravity="start"
                android:text="@string/Termos_Privacidade"
                android:textColor="@color/BordasDouradas"
                android:textSize="15sp" />
        </LinearLayout>


        <!-- Fechar conta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/retangulo_arredondado"

            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/closeAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cinzel_font_bold"
                android:gravity="start"
                android:text="@string/Exit_account"
                android:textColor="@color/BordasDouradas"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
